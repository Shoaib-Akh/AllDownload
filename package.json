{
  "name": "savefrompro",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "node --test tests/*.test.js --exclude tests/live-download.test.js",
    "test:live": "LIVE_DOWNLOAD=1 node --test tests/live-download.test.js",
    "pages:build": "npx @cloudflare/next-on-pages",
    "pages:preview": "npm run pages:build && wrangler pages dev",
    "pages:deploy": "npm run pages:build && wrangler pages deploy .vercel/output/static",
    "d1:migrate:local": "wrangler d1 execute savefrompro-db --local --file=./drizzle/0001_create_tables.sql",
    "d1:migrate:remote": "wrangler d1 execute savefrompro-db --remote --file=./drizzle/0001_create_tables.sql"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "^1.13.16",
    "drizzle-orm": "^0.45.2",
    "framer-motion": "^13.2.0",
    "lucide-react": "^1.45.0",
    "next": "14.2.35",
    "react": "^18",
    "react-dom": "^18",
    "wrangler": "^4.131.1"
  },
  "devDependencies": {
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
